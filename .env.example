# =================================================================
# NanoVision AI - Environment Configuration
# =================================================================

# Security & Session Authentication
SECRET_KEY=nanovision-ultra-secure-scientific-jwt-key-2026-v1
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default for zero-config local run, PostgreSQL supported)
DATABASE_URL=sqlite:///./backend/nanovision.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nanovision

# AI Assistant (NanoBot) Configuration
# Leave blank to use built-in domain-expert scientific rules & RAG engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage & Limits
MAX_UPLOAD_SIZE_MB=50

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

